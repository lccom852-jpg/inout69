<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>บัญชีรายรับ - รายจ่ายส่วนตัว</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Sarabun', sans-serif; background-color: #f8fafc; }
    /* ป้องกัน iOS ซูมหน้าจออัตโนมัติเมื่อกดช่องพิมพ์ */
    input, select, button { font-size: 16px !important; }
    @media (min-width: 768px) { input, select, button { font-size: 14px !important; } }
  </style>
</head>
<body class="p-3 md:p-6 text-gray-800">

  <!-- ==================== หน้าเข้าสู่ระบบ / สมัครสมาชิก ==================== -->
  <div id="authSection" class="max-w-md mx-auto mt-6 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
    <div class="text-center mb-6">
      <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-2">
        <i class="fa-solid fa-wallet"></i>
      </div>
      <h1 class="text-xl font-bold text-gray-900" id="authTitle">เข้าสู่ระบบ</h1>
      <p class="text-xs text-gray-500">จัดการระบบการเงินส่วนบุคคลของคุณ</p>
    </div>

    <form id="authForm" onsubmit="handleAuth(event)" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">ชื่อผู้ใช้งาน (Username)</label>
        <input type="text" id="authUsername" required placeholder="กรอกชื่อผู้ใช้..." class="w-full border border-gray-200 rounded-xl px-3 py-2.5 outline-none focus:ring-2 focus:ring-blue-500 bg-gray-50/50">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">รหัสผ่าน (Password)</label>
        <input type="password" id="authPassword" required placeholder="กรอกรหัสผ่าน..." class="w-full border border-gray-200 rounded-xl px-3 py-2.5 outline-none focus:ring-2 focus:ring-blue-500 bg-gray-50/50">
      </div>
      
      <button type="submit" id="btnAuthSubmit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition shadow-sm flex items-center justify-center gap-2">
        <span>เข้าสู่ระบบ</span>
      </button>
    </form>

    <div class="mt-4 text-center">
      <button onclick="toggleAuthMode()" id="btnToggleAuth" class="text-xs text-blue-600 hover:underline font-medium">
        ยังไม่มีบัญชี? สมัครสมาชิกที่นี่
      </button>
    </div>
  </div>

  <!-- ==================== หน้าแดชบอร์ดหลัก ==================== -->
  <div id="mainDashboard" class="hidden max-w-6xl mx-auto space-y-4 md:space-y-6">

    <!-- แถบด้านบนแสดงชื่อผู้ใช้ และปุ่มออกจากระบบ -->
    <div class="flex items-center justify-between bg-white p-4 rounded-2xl border border-gray-100 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 md:w-12 md:h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl md:text-2xl">
          <i class="fa-solid fa-user-circle"></i>
        </div>
        <div>
          <h1 class="text-base md:text-lg font-bold text-gray-900 leading-tight" id="txtWelcome">ยินดีต้อนรับ</h1>
          <p class="text-xs text-gray-400">สรุปภาพรวมการเงิน</p>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <button onclick="fetchData()" title="รีเฟรชข้อมูล" class="px-3 py-2 bg-gray-50 border border-gray-200 hover:bg-gray-100 text-gray-700 text-xs rounded-xl transition">
          <i class="fa-solid fa-rotate-right"></i>
        </button>
        <button onclick="logout()" title="ออกจากระบบ" class="px-3 py-2 bg-rose-50 border border-rose-100 text-rose-600 hover:bg-rose-100 text-xs rounded-xl font-medium transition flex items-center gap-1">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span class="hidden sm:inline">ออก</span>
        </button>
      </div>
    </div>

    <!-- ข้อความสถานะกำลังโหลด -->
    <div id="loadingStatus" class="hidden text-xs text-blue-600 font-medium text-center py-1">
      <i class="fa-solid fa-spinner fa-spin"></i> กำลังประมวลผล...
    </div>

    <!-- การ์ดสรุปยอดเงิน -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-5">
      <div class="bg-emerald-50/50 border border-emerald-100 rounded-2xl p-4 md:p-5 flex justify-between items-center">
        <div>
          <span class="text-emerald-700 font-semibold text-xs md:text-sm">รายรับรวม</span>
          <div class="text-2xl md:text-3xl font-bold text-emerald-600 mt-1" id="txtTotalIncome">0.00</div>
        </div>
        <div class="w-10 h-10 bg-emerald-100/80 rounded-xl flex items-center justify-center text-emerald-600 text-lg">
          <i class="fa-solid fa-arrow-down"></i>
        </div>
      </div>

      <div class="bg-rose-50/50 border border-rose-100 rounded-2xl p-4 md:p-5 flex justify-between items-center">
        <div>
          <span class="text-rose-600 font-semibold text-xs md:text-sm">รายจ่ายรวม</span>
          <div class="text-2xl md:text-3xl font-bold text-rose-500 mt-1" id="txtTotalExpense">0.00</div>
        </div>
        <div class="w-10 h-10 bg-rose-100/80 rounded-xl flex items-center justify-center text-rose-500 text-lg">
          <i class="fa-solid fa-arrow-up"></i>
        </div>
      </div>

      <div class="bg-blue-50/50 border border-blue-100 rounded-2xl p-4 md:p-5 flex justify-between items-center">
        <div>
          <span class="text-blue-600 font-semibold text-xs md:text-sm">คงเหลือสุทธิ</span>
          <div class="text-2xl md:text-3xl font-bold text-blue-600 mt-1" id="txtNetBalance">0.00</div>
        </div>
        <div class="w-10 h-10 bg-blue-100/80 rounded-xl flex items-center justify-center text-blue-600 text-lg">
          <i class="fa-solid fa-wallet"></i>
        </div>
      </div>
    </div>

    <!-- ส่วนกรอกข้อมูล และ ตารางแสดงผล (รองรับมือถือ) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6">
      
      <!-- บล็อกรายรับ -->
      <div class="bg-white border border-gray-100 rounded-2xl p-4 md:p-5 shadow-sm space-y-3">
        <h2 class="text-sm font-bold text-emerald-600 flex items-center gap-2">
          <i class="fa-solid fa-plus-circle"></i> บันทึกรายรับ
        </h2>
        
        <div class="space-y-2 bg-emerald-50/30 p-3 rounded-xl border border-emerald-100">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input type="text" id="inIncDate" placeholder="วันที่" class="border border-gray-200 rounded-lg px-3 py-2 text-xs w-full bg-white">
            <input type="number" id="inIncAmount" placeholder="จำนวนเงิน (บาท)" class="border border-gray-200 rounded-lg px-3 py-2 text-xs w-full bg-white">
          </div>
          <input type="text" id="inIncTitle" placeholder="ชื่อรายการ..." class="border border-gray-200 rounded-lg px-3 py-2 text-xs w-full bg-white">
          <button onclick="addRecord('income')" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold shadow-sm transition">
            บันทึกรายรับ
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead>
              <tr class="text-gray-400 border-b">
                <th class="py-2">วันที่</th>
                <th class="py-2">รายการ</th>
                <th class="py-2 text-right">จำนวน</th>
                <th class="py-2 text-center">จัดการ</th>
              </tr>
            </thead>
            <tbody id="tblIncomeBody" class="divide-y divide-gray-50"></tbody>
          </table>
        </div>
      </div>

      <!-- บล็อกรายจ่าย -->
      <div class="bg-white border border-gray-100 rounded-2xl p-4 md:p-5 shadow-sm space-y-3">
        <h2 class="text-sm font-bold text-rose-500 flex items-center gap-2">
          <i class="fa-solid fa-minus-circle"></i> บันทึกรายจ่าย
        </h2>
        
        <div class="space-y-2 bg-rose-50/30 p-3 rounded-xl border border-rose-100">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <input type="text" id="inExpDate" placeholder="วันที่" class="border border-gray-200 rounded-lg px-3 py-2 text-xs w-full bg-white">
            <input type="number" id="inExpAmount" placeholder="จำนวนเงิน (บาท)" class="border border-gray-200 rounded-lg px-3 py-2 text-xs w-full bg-white">
          </div>
          <input type="text" id="inExpTitle" placeholder="ชื่อรายการ..." class="border border-gray-200 rounded-lg px-3 py-2 text-xs w-full bg-white">
          <button onclick="addRecord('expense')" class="w-full py-2 bg-rose-500 hover:bg-rose-600 text-white rounded-lg text-xs font-semibold shadow-sm transition">
            บันทึกรายจ่าย
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead>
              <tr class="text-gray-400 border-b">
                <th class="py-2">วันที่</th>
                <th class="py-2">รายการ</th>
                <th class="py-2 text-right">จำนวน</th>
                <th class="py-2 text-center">จัดการ</th>
              </tr>
            </thead>
            <tbody id="tblExpenseBody" class="divide-y divide-gray-50"></tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <!-- JavaScript ส่วนควบคุม Client-side -->
  <script>
    let currentUser = null;
    let isRegisterMode = false;
    let incomeData = [];
    let expenseData = [];

    function formatCurrency(num) {
      return num.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function getTodayThString() {
      const months = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
      const d = new Date();
      return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear() + 543}`;
    }

    function showLoading(show) {
      document.getElementById('loadingStatus').classList.toggle('hidden', !show);
    }

    function toggleAuthMode() {
      isRegisterMode = !isRegisterMode;
      document.getElementById('authTitle').innerText = isRegisterMode ? 'สมัครสมาชิก' : 'เข้าสู่ระบบ';
      document.getElementById('btnAuthSubmit').innerText = isRegisterMode ? 'ลงทะเบียน' : 'เข้าสู่ระบบ';
      document.getElementById('btnToggleAuth').innerText = isRegisterMode ? 'มีบัญชีอยู่แล้ว? เข้าสู่ระบบ' : 'ยังไม่มีบัญชี? สมัครสมาชิกที่นี่';
    }

    function handleAuth(e) {
      e.preventDefault();
      const user = document.getElementById('authUsername').value.trim();
      const pass = document.getElementById('authPassword').value.trim();

      showLoading(true);
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        if (isRegisterMode) {
          google.script.run.withSuccessHandler(res => {
            showLoading(false);
            alert(res.message);
            if (res.success) toggleAuthMode();
          }).registerUser(user, pass);
        } else {
          google.script.run.withSuccessHandler(res => {
            showLoading(false);
            if (res.success) {
              currentUser = res.user;
              localStorage.setItem('app_user', JSON.stringify(currentUser));
              initApp();
            } else {
              alert(res.message);
            }
          }).loginUser(user, pass);
        }
      }
    }

    function logout() {
      localStorage.removeItem('app_user');
      currentUser = null;
      document.getElementById('mainDashboard').classList.add('hidden');
      document.getElementById('authSection').classList.remove('hidden');
    }

    function initApp() {
      document.getElementById('authSection').classList.add('hidden');
      document.getElementById('mainDashboard').classList.remove('hidden');
      document.getElementById('txtWelcome').innerText = `บัญชีผู้ใช้: ${currentUser.username}`;
      document.getElementById('inIncDate').value = getTodayThString();
      document.getElementById('inExpDate').value = getTodayThString();
      fetchData();
    }

    function render() {
      const sumIncome = incomeData.reduce((acc, curr) => acc + curr.amount, 0);
      const sumExpense = expenseData.reduce((acc, curr) => acc + curr.amount, 0);

      document.getElementById('txtTotalIncome').innerText = formatCurrency(sumIncome);
      document.getElementById('txtTotalExpense').innerText = formatCurrency(sumExpense);
      document.getElementById('txtNetBalance').innerText = formatCurrency(sumIncome - sumExpense);

      document.getElementById('tblIncomeBody').innerHTML = incomeData.map(item => `
        <tr class="hover:bg-gray-50">
          <td class="py-2.5 text-gray-400 text-[11px]">${item.date}</td>
          <td class="py-2.5 font-medium text-gray-800">${item.title}</td>
          <td class="py-2.5 text-right font-bold text-emerald-600">${formatCurrency(item.amount)}</td>
          <td class="py-2.5 text-center">
            <button onclick="deleteRecord('income', '${item.id}')" class="text-gray-300 hover:text-rose-500 p-1">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </td>
        </tr>
      `).join('');

      document.getElementById('tblExpenseBody').innerHTML = expenseData.map(item => `
        <tr class="hover:bg-gray-50">
          <td class="py-2.5 text-gray-400 text-[11px]">${item.date}</td>
          <td class="py-2.5 font-medium text-gray-800">${item.title}</td>
          <td class="py-2.5 text-right font-bold text-rose-500">-${formatCurrency(item.amount)}</td>
          <td class="py-2.5 text-center">
            <button onclick="deleteRecord('expense', '${item.id}')" class="text-gray-300 hover:text-rose-500 p-1">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </td>
        </tr>
      `).join('');
    }

    function fetchData() {
      if (!currentUser) return;
      showLoading(true);
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run.withSuccessHandler(data => {
          showLoading(false);
          if (data) {
            incomeData = data.incomeData;
            expenseData = data.expenseData;
            render();
          }
        }).getDashboardData(currentUser.userId);
      }
    }

    function addRecord(type) {
      const isInc = type === 'income';
      const dateEl = document.getElementById(isInc ? 'inIncDate' : 'inExpDate');
      const titleEl = document.getElementById(isInc ? 'inIncTitle' : 'inExpTitle');
      const amountEl = document.getElementById(isInc ? 'inIncAmount' : 'inExpAmount');

      const titleVal = titleEl.value.trim();
      const amountVal = parseFloat(amountEl.value);

      if (!titleVal || isNaN(amountVal) || amountVal <= 0) {
        alert('กรุณากรอกข้อมูลรายการและจำนวนเงินให้ถูกต้อง');
        return;
      }

      const newObj = {
        id: String(Date.now()),
        userId: currentUser.userId,
        type: isInc ? 'รายรับ' : 'รายจ่าย',
        date: dateEl.value.trim() || getTodayThString(),
        title: titleVal,
        amount: amountVal
      };

      if (isInc) incomeData.unshift(newObj);
      else expenseData.unshift(newObj);
      render();

      titleEl.value = '';
      amountEl.value = '';

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        showLoading(true);
        google.script.run.withSuccessHandler(() => showLoading(false)).addTransaction(newObj);
      }
    }

    function deleteRecord(type, id) {
      if (confirm('ยืนยันการลบรายการนี้?')) {
        if (type === 'income') incomeData = incomeData.filter(i => i.id !== id);
        else expenseData = expenseData.filter(i => i.id !== id);
        render();

        if (typeof google !== 'undefined' && google.script && google.script.run) {
          showLoading(true);
          google.script.run.withSuccessHandler(() => showLoading(false)).deleteTransaction(id, currentUser.userId);
        }
      }
    }

    // ตรวจสอบการเข้าสู่ระบบค้างไว้เมื่อโหลดหน้าเว็บ
    document.addEventListener('DOMContentLoaded', () => {
      const savedUser = localStorage.getItem('app_user');
      if (savedUser) {
        currentUser = JSON.parse(savedUser);
        initApp();
      }
    });
  </script>
</body>
</html>
